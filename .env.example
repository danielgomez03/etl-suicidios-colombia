# Copiar como .env y poner los valores reales (el .env no deberia subirse al repositorio)

# Token de aplicacion de datos.gov.co (Socrata): https://www.datos.gov.co/profile/edit/developer_settings
SOCRATA_APP_TOKEN=pon_aqui_tu_token

# Destino de la carga. Por defecto SQLite (no requiere instalar nada):
DATABASE_URL=sqlite:///data/gold/suicidios.db
# Recomendado (permite roles y control de acceso, ver sql/roles_postgres.sql):
# DATABASE_URL=postgresql+psycopg2://usuario:contrasena@localhost:5432/suicidios
